# Database
# Leave empty to use the zero-setup embedded PGlite database (~/.tamaragna/pglite)
# For Render, use Supabase's Shared pooler in SESSION mode (port 5432) and
# append ?sslmode=require. Use transaction mode (6543) only for serverless.
DATABASE_URL=
POSTGRES_MAX=1

# Optional override for the embedded database directory
PGLITE_DIR=

# Public origin used by canonical URLs, OG images and share links
NEXT_PUBLIC_SITE_URL=

# Production security + feature flags
TAMARAGNA_HTTPS=0
FEATURE_SHARE=1
FEATURE_TELEMETRY=1
FEATURE_ACCOUNTS=1
FEATURE_EVOLUTION=1
FEATURE_LIVE_PVP=1

# Accounts and email (set AUTH_DEV_MODE=1 only for local magic-link testing)
AUTH_DEV_MODE=0
OWNER_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Admin, cron and live room tickets
ADMIN_TOKEN=
CRON_SECRET=
LIVE_TOKEN_SECRET=

# Sprite provider: ragassets | divine-pride | zrenderer
ASSET_PROVIDER=ragassets

# Only used when ASSET_PROVIDER=zrenderer
ZRENDERER_URL=
ZRENDERER_TOKEN=
